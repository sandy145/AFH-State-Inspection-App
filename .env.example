# ---------------------------------------------------------------------------
# AFH Compliance Portal — example environment
# Copy to .env for local development. Never commit a real .env.
# ---------------------------------------------------------------------------

# PostgreSQL (docker compose brings this up on 5432).
# On a serverless host, point DATABASE_URL at a connection pooler and
# DIRECT_DATABASE_URL at the direct port — migrations need a session connection.
DATABASE_URL="postgresql://afh:afh_dev_password@localhost:5432/afh_portal?schema=public"
DIRECT_DATABASE_URL="postgresql://afh:afh_dev_password@localhost:5432/afh_portal?schema=public"

# Signing key for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-a-long-random-value"
SESSION_TTL_MINUTES="60"

# Environment. Development-only demo credentials refuse to seed unless this is
# "development" or "test" — see prisma/seed.ts and src/lib/env.ts.
NODE_ENV="development"
APP_ENV="development"
APP_URL="http://localhost:3000"

# The session cookie's Secure flag follows the scheme in APP_URL. Set this only
# to override that (for example behind a TLS-terminating proxy).
# COOKIE_SECURE="true"

# --- Document storage -------------------------------------------------------
# "local" writes to STORAGE_LOCAL_PATH; "s3" targets MinIO or AWS S3;
# "database" keeps bytes in Postgres, for a serverless demo with no object store.
# Production on Azure swaps in the Blob driver behind the same interface.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH=".storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-west-2"
S3_BUCKET="afh-evidence"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Upload limits (bytes). 25 MB default.
MAX_UPLOAD_BYTES="26214400"

# --- Email ------------------------------------------------------------------
# MailHog in docker compose. Email carries links only, never documents.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AFH Compliance Portal <no-reply@afh-portal.local.test>"
# "log" prints to the console instead of sending; "smtp" sends via the above.
MAIL_DRIVER="log"

# --- Development demo accounts ---------------------------------------------
# Seeds the demo users documented in the README. MUST be false outside dev/test.
SEED_DEMO_ACCOUNTS="true"
DEMO_PASSWORD="AfhPortal!Dev2026"
# Lists the demo accounts on the login page. Anyone can sign in with them, so
# leave this off unless the deployment is meant to be open. Never on in production.
SHOW_DEMO_CREDENTIALS="true"
